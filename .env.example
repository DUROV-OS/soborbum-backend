# Copy to .env and set unique secrets before startup. Never commit .env.
ENVIRONMENT=development
POSTGRES_PASSWORD=
# Use the same password as POSTGRES_PASSWORD (URL-encode it in this URL).
DATABASE_URL=postgresql+psycopg2://soborbum:REPLACE_PASSWORD@db:5432/soborbum
# Generate a unique value of at least 32 characters.
JWT_SECRET=
STORAGE_DIR=/app/storage
ADMIN_EMAIL=admin@soborbum.local
# Required only when creating the first administrator; at least 12 characters.
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Administrator

CORS_ALLOWED_ORIGINS=http://localhost:5173
UVICORN_RELOAD=0

# AI assistant. Today and operational sections work without a provider key.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
# Remote MCP connector to the knowledge base. No token endpoint to set here
# - it's auto-discovered from MCP_SERVER_URL (see app/ai/mcp_auth.py).
# Leave empty until you have connection details, the AI section works fine
# without it. MCP_REDIRECT_URI must be one of the redirect URIs registered
# for this client with the provider; it defaults to the loopback callback on
# the port the API itself serves.
MCP_SERVER_URL=
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
MCP_REDIRECT_URI=http://127.0.0.1:8005/callback
